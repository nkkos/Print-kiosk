{
  "name": "print-kiosk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:server\"",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "seed:staff": "tsx server/scripts/seedStaffAccount.ts",
    "set:roster": "tsx server/scripts/setRosterDay.ts",
    "format": "prettier --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "bcryptjs": "^3.0.3",
    "clamscan": "^2.4.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "heic-convert": "^2.1.0",
    "libreoffice-convert": "^1.8.2",
    "mailparser": "^3.9.14",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.8.0",
    "pdfjs-dist": "^6.2.108",
    "perspective-transform": "^1.1.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/clamscan": "^2.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/heic-convert": "^2.1.1",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
