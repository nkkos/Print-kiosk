# Base URL the kiosk frontend itself uses to reach the QR/Email upload
# backend (server/) — this machine only, so localhost is correct here. The
# phone uses a different, auto-detected LAN/public URL (see GET /api/config)
# since it's a separate device on the network.
VITE_API_BASE_URL=http://localhost:3001

# Domain the kiosk generates real inbound-email addresses under
# (upload-<prefix>@<domain>) — see docs/email-upload-requirements.md. Set
# this to your real registered domain (Cloudflare Email Routing must be
# enabled for it, with the Worker in cloudflare-worker/ bound to it).
VITE_EMAIL_DOMAIN=yourdomain.example

# Postgres connection string — see README.md, "Database," for local Docker
# setup. Railway injects this automatically for the deployed backend once
# the Postgres service's DATABASE_URL is referenced into the backend's
# environment (one manual step in the Railway UI).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/print_kiosk

# Sends account-lifecycle emails (verification, password reset) — see
# README.md, "Portal." Leave unset for local dev: the email link is logged
# to the console instead of actually sent, so no real Resend account is
# needed to test the flow.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@yourdomain.example

# The deployed portal's public URL (Cloudflare Pages) — used to build the
# links inside those emails, and by GET /api/config's portalUrl (the kiosk's
# QR-code "Register" link). Leave unset for local dev: falls back to this
# machine's auto-detected LAN IP at Vite's default port, reachable from a
# phone testing the flow on the same Wi-Fi (same reasoning as the QR upload
# URL). Set explicitly once actually deployed.
# PORTAL_URL=https://portal.yourdomain.example

# "AI бэкграунд"'s Nano Banana Pro (Gemini 3 Pro Image) integration — sends
# the captured shot + chosen look to Google's API to composite them
# harmoniously (server-side only, never exposed to the client). Get a key at
# aistudio.google.com ("API keys" → "Create API key"), with billing/Prepaid
# credits enabled — the free tier's rate limit is too low for real kiosk
# traffic. Leave unset to disable this branch's compositing step.
# GEMINI_API_KEY=

# Personal Account ("My files") limits — deliberately separate from QR/Email's
# shared format rule above, and expected to change often (test values, not
# final) — see docs/personal-account-requirements.md, "Open items", and
# server/accountFileLimits.ts. All optional; defaults shown are the current
# draft values.
# ACCOUNT_FILE_ACCEPTED_EXTENSIONS=.pdf,.jpg,.jpeg
# ACCOUNT_FILE_RETENTION_DAYS=30
# ACCOUNT_FILE_MAX_TOTAL_STORAGE_MB=100

# Pavilion printer (Brother HL-L9430CDN + MX-4000 4-bin mailbox + LT-330CL
# lower tray) — see server/printerAdapter.ts. All optional: unset, every job
# goes to the Windows default printer with the driver's own tray choice
# (the home-printer dev setup).
# One Windows print queue per mailbox bin, each with its Printing Defaults
# pinned to "MX bin N" (Output Tray) — the reserved pickup bin picks the queue.
# PRINTER_QUEUE_BIN_1=HL9430-Bin1
# PRINTER_QUEUE_BIN_2=HL9430-Bin2
# PRINTER_QUEUE_BIN_3=HL9430-Bin3
# PRINTER_QUEUE_BIN_4=HL9430-Bin4
# Input tray per paper size (Brother codes: 1=Tray1, 2=Tray2/LT-330CL,
# 258=MP tray, 7=auto). Unset → driver auto-selects by paper size.
# PRINTER_TRAY_A4=1
# PRINTER_TRAY_A5=2

# Where print jobs are executed — see server/printOrchestrator.ts and README.md,
# "Print agent". Unset/`direct` = this backend prints to its own machine's
# printer (local dev). `agent` = cloud deployment: the pavilion print agent
# (npm run agent on the mini-PC) claims and prints jobs.
# PRINT_EXECUTION=agent
# Shared secret between the backend and the print agent (long random value).
# PRINT_AGENT_TOKEN=
# Agent side only: the backend it polls.
# AGENT_CLOUD_URL=https://your-app.up.railway.app
# Agent side: printer health over SNMP (enable SNMP v1/v2c read access in the
# Brother's Web Based Management first), or a hand-edited JSON simulator file.
# PRINTER_SNMP_HOST=192.168.1.50
# PRINTER_SNMP_COMMUNITY=public
# PRINTER_STATUS_SIMULATOR_FILE=./sim-printer.json
# AGENT_DRY_RUN=true
# AGENT_PROBLEM_GRACE_MS=60000

# Kiosk build: hides the "Simulate …" print-outcome buttons. Set to true for
# customer-facing builds once the print agent reports real outcomes.
# VITE_HIDE_PRINT_SIMULATE=true
